# Скопіюйте цей файл у .env і впишіть свої дані.
# Файл .env вже доданий у .gitignore, тому паролі не потраплять у репозиторій.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_SENDER=your_email@gmail.com
# true - для порту 465 (SSL), false - для порту 587 (STARTTLS)
SMTP_USE_SSL=false

# Секретний ключ для підпису посилань підтвердження (chat_app/tokens.py)
SECRET_KEY=change_me_to_a_long_random_string
